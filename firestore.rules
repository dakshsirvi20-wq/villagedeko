rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function owner(data) { return signedIn() && data.ownerUid == request.auth.uid; }

    match /users/{userId} {
      allow read, write: if signedIn() && request.auth.uid == userId;
      match /saved/{postId} { allow read, write: if signedIn() && request.auth.uid == userId; }
    }

    match /villagesListings/{id} {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.ownerUid == request.auth.uid;
      allow update, delete: if owner(resource.data);
      match /followers/{userId} {
        allow read: if signedIn();
        allow create: if signedIn() && userId == request.auth.uid && request.resource.data.uid == request.auth.uid;
        allow delete: if signedIn() && userId == request.auth.uid;
      }
    }

    match /posts/{id} {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.ownerUid == request.auth.uid;
      allow update, delete: if owner(resource.data);
      match /likes/{userId} {
        allow read: if signedIn();
        allow create: if signedIn() && userId == request.auth.uid;
        allow delete: if signedIn() && userId == request.auth.uid;
      }
      match /comments/{commentId} {
        allow read: if signedIn();
        allow create: if signedIn() && request.resource.data.uid == request.auth.uid;
        allow delete: if signedIn() && resource.data.uid == request.auth.uid;
      }
    }

    match /weddingInquiries/{id} {
      allow read: if signedIn() && resource.data.ownerUid == request.auth.uid;
      allow create: if signedIn() && request.resource.data.ownerUid == request.auth.uid;
      allow update, delete: if signedIn() && resource.data.ownerUid == request.auth.uid;
    }
  }
}
